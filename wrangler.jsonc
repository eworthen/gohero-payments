{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gohero-payments",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-22",
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "production",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD_ADMIN": "",
    "CF_ACCESS_AUD_API": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gohero-payments-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "worker/db/migrations"
    }
  ],
  "env": {
    "development": {
      "vars": {
        "APP_ENV": "development",
        "DEV_AUTH_ENABLED": "true",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD_ADMIN": "",
        "CF_ACCESS_AUD_API": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gohero-payments-local",
          "database_id": "00000000-0000-4000-8000-000000000099",
          "migrations_dir": "worker/db/migrations"
        }
      ]
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  }
}